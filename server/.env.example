# MongoDB Atlas (Atlas > Database Access / Connect). Never commit real values.
# Database user: role readWrite on DB_NAME only.
MONGODB_USERNAME=
MONGODB_PASSWORD=
# The part after '@' in Atlas > Connect > Drivers, e.g. cluster0.ab1cd.mongodb.net
MONGODB_HOST=
MONGODB_OPTIONS=retryWrites=true&w=majority
DB_NAME=stw_neo

# Comma-separated API keys for app write routes. Generate random values, e.g.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# The same key goes into build.env as API_KEY. Production refuses the old
# development keys (stw_dev_client_key_12345, stw_mobile_app_prod_key).
API_KEYS=

# Dedicated read-only key for /export endpoints (random, different from API_KEYS)
EXPORT_API_KEY=

# CORS: origins of the website/PWA, e.g. https://stw.example.org (the APK needs none)
ALLOWED_ORIGINS=http://localhost:8080

# Server HTTP Port (pick a free one on a shared server: ss -ltn)
PORT=4000

# Listen address. 127.0.0.1 on a server: only nginx can reach the API.
HOST=

# Behind a reverse proxy (nginx, load balancer): number of proxy hops, e.g. 1.
# Without it every client shares the proxy's IP for rate limiting.
TRUST_PROXY=

# Requests per minute per client IP (each screening answer is one request)
RATE_LIMIT_PER_MINUTE=120
